# Dockerfile for dbt + DuckDB runner
FROM python:3.11-slim-bookworm

# Install system utilities and security updates
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /usr/app/dbt

# Install dbt-core, dbt-duckdb, and supporting libraries
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
    dbt-core>=1.8.0 \
    dbt-duckdb>=1.8.0 \
    duckdb==1.1.3 \
    boto3 \
    pyyaml \
    python-dotenv

# Download DuckDB extensions directly over HTTPS to bypass unencrypted HTTP middlebox
RUN mkdir -p /root/.duckdb/extensions/v1.1.3/linux_amd64_gcc4 && \
    curl -sSL "https://extensions.duckdb.org/v1.1.3/linux_amd64_gcc4/httpfs.duckdb_extension.gz" | gzip -d > /root/.duckdb/extensions/v1.1.3/linux_amd64_gcc4/httpfs.duckdb_extension && \
    curl -sSL "https://extensions.duckdb.org/v1.1.3/linux_amd64_gcc4/parquet.duckdb_extension.gz" | gzip -d > /root/.duckdb/extensions/v1.1.3/linux_amd64_gcc4/parquet.duckdb_extension && \
    python3 -c "import duckdb; con = duckdb.connect(); con.execute('LOAD httpfs; LOAD parquet;'); print('Extensions verified successfully!')"

# Set default environment variables for dbt
ENV DBT_PROFILES_DIR=/usr/app/dbt
ENV PYTHONUNBUFFERED=1

ENTRYPOINT ["dbt"]
CMD ["--help"]
